  "invalid_vectors": [
    {
      "id": "absolute",
      "base": "zero-pack",
      "mutation": {
        "manifest.config_entrypoint": "/tmp/deployment.json"
      },
      "expected": "reject path before hashing/load"
    },
    {
      "id": "traversal",
      "base": "zero-pack",
      "mutation": {
        "manifest.config_roots": [
          "soot/../other"
        ]
      },
      "expected": "reject noncanonical path before hashing/load"
    },
    {
      "id": "symlink",
      "base": "zero-pack",
      "mutation": {
        "replace_file": "soot/ai.json",
        "kind": "symlink",
        "target": "../../private.json"
      },
      "expected": "reject link without reading target"
    },
    {
      "id": "private-env",
      "base": "zero-pack",
      "mutation": {
        "add_file": "soot/.env",
        "bytes_utf8": "TOKEN=CHANGE_ME\n"
      },
      "expected": "reject forbidden private path even with placeholder"
    },
    {
      "id": "private-db",
      "base": "zero-pack",
      "mutation": {
        "add_file": "soot/conversations.db",
        "bytes_hex": ""
      },
      "expected": "reject private state even when empty"
    },
    {
      "id": "file-tamper",
      "base": "zero-pack",
      "mutation": {
        "append_to_file": "soot/soots/support/mission.md",
        "bytes_utf8": "!"
      },
      "expected": "source digest mismatch; no automatic refresh"
    },
    {
      "id": "metadata-tamper",
      "base": "zero-pack",
      "mutation": {
        "manifest.guide_files": []
      },
      "expected": "source digest mismatch; safe metadata is covered"
    },
    {
      "id": "archive-tamper",
      "base": "optional-local-package-installed-without-grant",
      "mutation": {
        "flip_byte": "vendor/fixturepack.zip",
        "offset": 0
      },
      "expected": "archive SHA-256 mismatch and source digest mismatch"
    },
    {
      "id": "installed-tree-tamper",
      "base": "optional-local-package-installed-without-grant",
      "mutation": {
        "append_installed_file": "soot/packs.d/fixturepack/skill.md",
        "bytes_utf8": "!"
      },
      "expected": "materialized package tree mismatch even though authored digest unchanged"
    },
    {
      "id": "missing-selected-executable",
      "base": "optional-local-package-explicit-inspect-grant",
      "mutation": {
        "operator_PATH": "empty",
        "remove_execute_bits_from_installed_file": "soot/packs.d/fixturepack/tools/inspect.sh"
      },
      "expected": "tree execute-bit mismatch and selected program admission denied"
    },
    {
      "id": "symlink-directory",
      "base": "zero-pack",
      "mutation": {
        "replace_directory": "soot/soots",
        "kind": "symlink",
        "target": "../../other"
      },
      "expected": "reject link component without following it"
    },
    {
      "id": "extra-installed-private",
      "base": "optional-local-package-installed-without-grant",
      "mutation": {
        "add_installed_file": "soot/packs.d/fixturepack/vault.json",
        "bytes_utf8": "{}"
      },
      "expected": "reject private state before receipt/tree admission"
    }
  ],
  "equivalence_vectors": [
    {
      "base": "zero-pack",
      "mutation": "reindent manifest/reorder object keys/change LF to CRLF only in manifest JSON whitespace",
      "expected": "same authored source digest"
    },
    {
      "base": "zero-pack",
      "mutation": "change source_digest.value only",
      "expected": "same calculated digest; supplied incorrect value still rejected"
    },
    {
      "base": "zero-pack",
      "mutation": "change a regular file from 0600 to 0644",
      "expected": "same digest"
    },
    {
      "base": "zero-pack",
      "mutation": "add any execute bit to a regular file",
      "expected": "different digest"
    },
    {
      "base": "optional-local-package-installed-without-grant",
      "mutation": "make /bin/sh unavailable in an isolated consumer host while inspect remains unselected",
      "expected": "no executable preflight requirement from unselected capability; pack structural/hash validation remains required"
    }
  ]
}
