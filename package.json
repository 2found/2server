{
  "name": "@2server/cli",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "start": "bun src/cli.ts",
    "check": "tsc --noEmit && bun test ./tests",
    "test": "bun test ./tests"
  },
  "dependencies": {
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "typescript": "^5.9.0"
  },
  "bin": {
    "2server": "bin/2server.cjs"
  },
  "description": "Stateless SSH infrastructure CLI for Docker, Caddy, Cloudflare and single-VM services",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lohi-ai/2server.git"
  },
  "homepage": "https://github.com/lohi-ai/2server#readme",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "bin/",
    "src/",
    "scripts/bootstrap.sh",
    "scripts/release.sh",
    "terraform/gcp/*.tf",
    "skills/2server/",
    "docs/",
    "examples/",
    ".env.example",
    "terraform/aws/*.tf",
    "terraform/gcs-backup/*.tf"
  ],
  "engines": {
    "node": ">=20"
  }
}
