{
  "name": "@2server/cli",
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "start": "bun src/cli.ts",
    "check": "bun scripts/gen-extension-types.ts --check && tsc --noEmit && bun test ./tests",
    "gen:extension-types": "bun scripts/gen-extension-types.ts",
    "test": "bun test ./tests",
    "release:check": "node scripts/release-check.mjs"
  },
  "dependencies": {
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "typescript": "^5.9.0"
  },
  "bin": {
    "2srv": "bin/2server.cjs",
    "2server": "bin/2server.cjs"
  },
  "description": "Infrastructure and deployment on your own VM — a 2found tool for Docker, Caddy and Cloudflare",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/2found/2server.git"
  },
  "homepage": "https://github.com/2found/2server#readme",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "AGENTS.md",
    "BRANDING.md",
    "README.vi.md",
    "bin/",
    "src/",
    "scripts/bootstrap.sh",
    "scripts/metadata-firewall.py",
    "scripts/release.sh",
    "scripts/gen-extension-types.ts",
    "terraform/gcp/*.tf",
    "terraform/gcp/access/*.tf",
    "skills/",
    ".claude-plugin/marketplace.json",
    ".agents/plugins/marketplace.json",
    "docs/",
    "examples/",
    ".env.example",
    "CHANGELOG.md",
    "terraform/aws/*.tf",
    "terraform/gcs-backup/*.tf"
  ],
  "engines": {
    "node": ">=20"
  }
}
