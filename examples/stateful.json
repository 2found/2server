{
  "version": 1,
  "name": "my-server",
  "ssh": {
    "kind": "gcp",
    "project": "example-project",
    "zone": "asia-southeast1-a",
    "instance": "two-server",
    "iap": true
  },
  "edge": { "mode": "managed" },
  "backupStorage": {
    "kind": "gcs",
    "storageClass": "ARCHIVE",
    "schedule": "*-*-* 00/6:00:00 UTC",
    "retentionDays": 7
  },
  "extensions": {
    "postgres": {
      "database": "app",
      "username": "app",
      "passwordEnv": "POSTGRES_PASSWORD",
      "backup": {}
    },
    "redis": {
      "passwordEnv": "REDIS_PASSWORD",
      "memoryMb": 256,
      "maxmemoryMb": 128
    },
    "nats": { "tokenEnv": "NATS_TOKEN", "jetstream": true, "maxFileGb": 5 }
  }
}
