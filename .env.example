# Bootstrap/legacy local mode only. Publish referenced values to the VM with server bootstrap (new VM) or server publish (existing setup).
# After connect, update VM secrets with secret set --env-file secrets.env --apply.
# Copy to .env in the 2server checkout, fill locally, and chmod 600 .env.
# Bun loads this file when commands run from the 2server directory.
CLOUDFLARE_API_TOKEN=""
# Optional: used by account-owned token verification/administration.
CLOUDFLARE_ACCOUNT_ID=""
# Set extensions.monitoring.passwordEnv to MONITORING_PASSWORD in the manifest.
# Use a unique 16–72 byte password. Never commit the real .env.
MONITORING_PASSWORD=""

# Optional private stateful extensions (at least 20 single-line characters).
POSTGRES_PASSWORD=
# Distinct secrets: app DML, cluster admin and migration role respectively.
POSTGRES_ADMIN_PASSWORD=
POSTGRES_MIGRATION_PASSWORD=
REDIS_PASSWORD=
NATS_TOKEN=

# Discord incoming webhook secret; reference with extensions.webhooks[].urlEnv.
DISCORD_WEBHOOK_URL=""
